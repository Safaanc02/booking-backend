# Copier en .env et adapter. Ce fichier-ci est versionné, .env ne l'est pas.

# ---- Base de données ----
# DB_PORT : port publié par docker compose côté hôte (5433 pour ne pas
# entrer en conflit avec un PostgreSQL déjà installé sur 5432).
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/beauty_booking
DB_USER=booking_user
DB_PASSWORD=changez-moi

# ---- Schéma ----
# update en développement ; validate dès que Flyway sera en place (jalon J0)
DDL_AUTO=update
SHOW_SQL=true

# ---- Serveur ----
SERVER_PORT=8080

# ---- Keycloak ----
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/booking-realm

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Console d'administration Keycloak (docker compose) ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changez-moi
