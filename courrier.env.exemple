# Accès à la boîte aux lettres de test, sous /courrier.
#
# À copier en courrier.env, qui n'est pas suivi par Git.
#
# L'empreinte s'obtient par :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<mot de passe>'
#
# Ne mettez pas de guillemets autour de la valeur : un env_file les garderait
# tels quels, et Caddy comparerait l'empreinte aux guillemets compris.
COURRIER_UTILISATEUR=darzin
COURRIER_HASH=
