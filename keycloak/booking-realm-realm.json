{
  "realm": "booking-realm",
  "enabled": true,
  "displayName": "Booking Maroc",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "ar",
    "en"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrateur de la plateforme"
      },
      {
        "name": "pro",
        "description": "Professionnel : gère un ou plusieurs salons"
      },
      {
        "name": "client",
        "description": "Client : réserve des prestations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "booking-app",
      "name": "Frontend web (React)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "fullScopeAllowed": true
    },
    {
      "clientId": "booking-backend",
      "name": "API Spring Boot",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@booking.ma",
      "firstName": "Super",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "pro1",
      "enabled": true,
      "emailVerified": true,
      "email": "pro1@booking.ma",
      "firstName": "Karim",
      "lastName": "Benali",
      "credentials": [
        {
          "type": "password",
          "value": "pro1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "pro"
      ]
    },
    {
      "username": "client1",
      "enabled": true,
      "emailVerified": true,
      "email": "client1@booking.ma",
      "firstName": "Salma",
      "lastName": "Idrissi",
      "credentials": [
        {
          "type": "password",
          "value": "client1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "client"
      ]
    }
  ],
  "loginTheme": "booking",
  "accountTheme": "keycloak.v3"
}
