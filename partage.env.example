# Environnement de la pile partagée. À copier en partage.env, qui n'est pas
# suivi par Git. ./scripts/partager.sh le crée avec des secrets tirés au sort
# si vous ne le faites pas.

# L'adresse à laquelle vos essayeurs joindront l'application, protocole
# compris et sans barre oblique finale. C'est la seule valeur à changer quand
# vous changez d'hébergement.
URL_PUBLIQUE=http://localhost:8090

# Port écouté sur la machine hôte.
PORT_PUBLIC=8090

# Aucune valeur par défaut : les mots de passe de développement sont publics.
DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
ANNULATION_SECRET=

# Doit être identique au secret inscrit dans keycloak/booking-realm-realm.json
# pour le client booking-backend-admin : c'est l'import du realm qui le fixe.
KEYCLOAK_ADMIN_CLIENT_SECRET=secret-de-developpement-a-remplacer
